# App (Project Settings -> API in Supabase)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=   # or the anon key on older projects
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Assistant (Phase 4). The model id is read only from here.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Tooling only, never needed by the running app:
# npm run db:migrate / db:rls-check / e2e:auth (Account -> Access Tokens in Supabase)
SUPABASE_ACCESS_TOKEN=
SUPABASE_PROJECT_REF=
# vercel CLI (Phase 5)
VERCEL_TOKEN=
